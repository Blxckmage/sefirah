{ pkgs, ... }:
{
  config.sefirah.homeModules = [
    ({ pkgs, ... }: {
      home.packages = [ pkgs.hyprlock ];

      # Config is generated by athanor transmute at ~/.config/athanor/current/hypr/hyprlock.conf
      # This file is a fallback for manual testing
      xdg.configFile."hypr/hyprlock.conf".text = ''
        # Fallback static config — real config generated by athanor transmute
        general {
            hide_cursor = true
        }
        background {
            monitor =
            path = ${../theme/wallpapers/epoch-umber-lock.png}
            color = rgb(16120e)
        }
        label {
            monitor =
            text = sefirah
            color = rgb(e3d6b8)
            font_family = PxPlus IBM VGA 8x16
            font_size = 12
            position = 72, -72
            halign = left
            valign = top
        }
        label {
            monitor =
            text = $(hostname)
            color = rgb(8d7d65)
            font_family = PxPlus IBM VGA 8x16
            font_size = 12
            position = 72, -100
            halign = left
            valign = top
        }
        label {
            monitor =
            text = $TIME
            color = rgb(e3d6b8)
            font_family = PxPlus IBM VGA 8x16
            font_size = 48
            position = 72, -210
            halign = left
            valign = top
        }
        label {
            monitor =
            text = @ sefirah, speak the word:
            color = rgb(e3d6b8)
            font_family = PxPlus IBM VGA 8x16
            font_size = 12
            position = 72, 168
            halign = left
            valign = bottom
        }
        input-field {
            monitor =
            size = 320, 44
            outline_thickness = 2
            rounding = 0
            outer_color = rgb(d49a3a)
            inner_color = rgb(16120e)
            font_color = rgb(e3d6b8)
            font_family = PxPlus IBM VGA 8x16
            check_color = rgb(8f9a5a)
            fail_color = rgb(d25f42)
            capslock_color = rgb(e8bd6a)
            fail_text = The word is wrong. ($ATTEMPTS)
            placeholder_text =
            fade_on_empty = false
            dots_size = 0.2
            dots_spacing = 0.4
            dots_rounding = 0
            position = 72, 108
            halign = left
            valign = bottom
        }
        label {
            monitor =
            text = Ready
            color = rgb(8d7d65)
            font_family = PxPlus IBM VGA 8x16
            font_size = 12
            position = 72, 64
            halign = left
            valign = bottom
        }
      '';
    })
  ];
}
