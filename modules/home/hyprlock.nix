{ ... }:
{
  config.sefirah.homeModules = [
    ({ config, pkgs, ... }:
    let
      homeDir = config.home.homeDirectory;
      sefirah = "${config.home.profileDirectory}/bin/sefirah";
    in
    {
      home.packages = [ pkgs.hyprlock ];

      # Static fallback for bare `hyprlock`; sefirah-lock and hypridle use the
      # generated config at ~/.config/sefirah/current/hypr/hyprlock.conf.
      xdg.configFile."hypr/hyprlock.conf".text = ''
        # Fallback static config — real config generated by sefirah transmute
        general {
            hide_cursor = true
            immediate_render = true
        }
        animations {
            enabled = false
        }
        background {
            monitor =
            path = ${../theme/wallpapers/epoch-umber-lock.png}
            color = rgb(16120e)
        }
        image {
            monitor =
            path = ${homeDir}/.cache/sefirah/sigil-umber.png
            size = 88
            rounding = 0
            border_size = 0
            position = 817, -72
            halign = left
            valign = top
        }
        label {
            monitor =
            text = cmd[update:60000] hostname
            color = rgb(e3d6b8)
            font_family = PxPlus IBM VGA 8x16
            font_size = 13
            position = 921, -92
            halign = left
            valign = top
        }
        label {
            monitor =
            text = cmd[update:60000] ${sefirah} sigil --fingerprint
            color = rgb(8d7d65)
            font_family = PxPlus IBM VGA 8x16
            font_size = 13
            position = 921, -116
            halign = left
            valign = top
        }
        label {
            monitor =
            text = $TIME
            color = rgb(e3d6b8)
            font_family = Jacquard 24,
            font_size = 161
            position = 817, -210
            halign = left
            valign = top
        }
        label {
            monitor =
            text = cmd[update:60000] ${sefirah} hour --lock e3d6b8,d49a3a,8d7d65
            color = rgb(e3d6b8)
            font_family = PxPlus IBM VGA 8x16
            font_size = 13
            position = 817, -460
            halign = left
            valign = top
        }
        image {
            monitor =
            path = ${homeDir}/.cache/sefirah/tarot-day.png
            reload_cmd = ${sefirah} draw --png
            reload_time = 600
            size = 320
            rounding = 0
            border_size = 0
            position = -72, 0
            halign = right
            valign = center
        }
        label {
            monitor =
            text = @ $USER, speak the word:
            color = rgb(e3d6b8)
            font_family = PxPlus IBM VGA 8x16
            font_size = 13
            position = 817, 168
            halign = left
            valign = bottom
        }
        input-field {
            monitor =
            size = 345, 48
            outline_thickness = 2
            rounding = 0
            outer_color = rgb(d49a3a)
            inner_color = rgb(16120e)
            font_color = rgb(e3d6b8)
            font_family = PxPlus IBM VGA 8x16
            check_color = rgb(7aa08c)
            fail_color = rgb(d25f42)
            capslock_color = rgb(d49a3a)
            fail_text = The word is wrong. ($ATTEMPTS)
            placeholder_text =
            fade_on_empty = false
            dots_size = 0.2
            dots_spacing = 0.4
            dots_rounding = 0
            position = 817, 108
            halign = left
            valign = bottom
        }
        label {
            monitor =
            text = cmd[update:5000] ${sefirah} status --short
            color = rgb(8d7d65)
            font_family = PxPlus IBM VGA 8x16
            font_size = 13
            position = 817, 64
            halign = left
            valign = bottom
        }
      '';
    })
  ];
}
