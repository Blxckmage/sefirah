{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 24,
  "modules-left": ["custom/nixos", "niri/workspaces"],
  "modules-center": ["custom/clock"],
  "modules-right": [
    "group/tray-expander",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu",
    "battery",
    "custom/power"
  ],
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "?",
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "active": "󰝤"
    },
    "tooltip": false,
    "cursor": "pointer",
    "on-scroll-up": "niri msg action focus-workspace-up",
    "on-scroll-down": "niri msg action focus-workspace-down"
  },
  "custom/nixos": {
    "format": "",
    "on-click": "tofi-drun --drun-launch=true",
    "on-click-right": "kitty",
    "tooltip-format": "Launcher\n\nSuper + D"
  },
  "cpu": {
    "interval": 5,
    "format": "cpu: {usage}%",
    "on-click": "foot --app-id waybar-btop -o main.pad=16x16 -e btop"
  },
  "custom/clock": {
    "exec": "/home/blackmage/.config/waybar/clock",
    "on-click": "/home/blackmage/.config/waybar/clock-toggle",
    "interval": 1,
    "tooltip": false
  },
  "network": {
    "format": "net",
    "format-wifi": "wifi: {signalStrength}%",
    "format-ethernet": "eth",
    "format-disconnected": "net: off",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "on-click": "foot --app-id waybar-wifi -o main.pad=16x16 -e impala"
  },
  "battery": {
    "format": "battery: {capacity}%",
    "format-discharging": "battery: {capacity}%",
    "format-charging": "battery: {capacity}%+",
    "format-plugged": "battery: {capacity}%+",
    "format-full": "battery: full",
    "tooltip-format-discharging": "{power:>1.0f}W down {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W up {capacity}%",
    "interval": 5,
    "on-click": "/home/blackmage/.config/niri/scripts/power-profile-tofi.sh",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "bluetooth",
    "format-disabled": "bluetooth: off",
    "format-off": "bluetooth: off",
    "format-connected": "bluetooth: {num_connections}",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}"
  },
  "pulseaudio": {
    "format": "{icon}: {volume}%",
    "format-icons": {
      "speaker": "speaker",
      "speaker-muted": "speaker",
      "headphone": "wired",
      "headphone-muted": "wired",
      "headset": "wired",
      "headset-muted": "wired",
      "default": "audio",
      "default-muted": "audio"
    },
    "on-click": "foot --app-id waybar-audio -o main.pad=16x16 -e wiremix",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "{icon}: mute"
  },
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },
  "custom/expand-icon": {
    "format": "tray",
    "tooltip": false
  },
  "custom/power": {
    "format": "power",
    "on-click": "/home/blackmage/.config/niri/scripts/power-tofi.sh",
    "tooltip-format": "Power menu\n\nSuper + Escape"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 12
  }
}
