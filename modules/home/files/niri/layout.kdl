layout {
    gaps 5

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667

    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off

        width 4

        active-color "#7fc8ff"

        inactive-color "#505050"
    }

    border {
        on

        width 2
        active-gradient from="#@@BASE0D@@" to="#@@BASE0B@@" angle=45
        inactive-color "#@@BASE02@@aa"

        urgent-color "#@@BASE08@@"
    }

    shadow {

        softness 30

        spread 5

        offset x=0 y=5

        color "#0007"
    }

    struts {
        left 10
        right 10
        top 10
        bottom 10
    }
}
