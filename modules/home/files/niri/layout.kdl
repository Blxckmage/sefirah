layout {
    gaps 6

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }

    border {
        on
        width 2
        active-color "#@@BASE09@@"
        inactive-color "#@@BASE02@@aa"
        urgent-color "#@@BASE08@@"
    }

    struts {
        left 12
        right 12
        top 12
        bottom 12
    }
}
