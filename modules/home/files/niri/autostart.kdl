spawn-at-startup "sh" "-c" "mkdir -p ~/.local/bin && ln -sf \\$(which athanor) ~/.local/bin/athanor"
spawn-at-startup "sh" "-c" "athanor transmute umber"
spawn-at-startup "hypridle"
spawn-at-startup "swaybg" "-i" "@@HOME@@/Pictures/wallpaper.jpg" "-m" "fill"
spawn-at-startup "sh" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "sh" "-c" "wl-paste --type image --watch cliphist store"
