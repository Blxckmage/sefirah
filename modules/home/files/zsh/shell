#history
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=$HISTSIZE

# sane defaults
setopt inc_append_history share_history hist_ignore_all_dups
setopt autocd no_beep interactivecomments
unsetopt nomatch

# Set complete path (no ./bin up front — insecure; ~/.local/bin only if present)
if [ -d "$HOME/.local/bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi
set +h

# completion (cached - only regenerate if dump is >24h old)
autoload -Uz compinit
if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi
zstyle ':completion:*' menu select
bindkey -e
