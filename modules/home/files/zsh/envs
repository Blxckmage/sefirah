# nh: default flake so bare `nh os switch` == `nh os switch /etc/nixos#sefirah`
# (-H/--hostname defaults to the local hostname automatically)
export NH_FLAKE="/etc/nixos"

# Editor used by CLI
export EDITOR="nvim"
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# starship
export STARSHIP_CONFIG=$HOME/.config/starship/starship.toml
export STARSHIP_CACHE=~/.starship/cache

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# npm (nodejs is read-only under nix; keep global installs in $HOME)
export NPM_CONFIG_PREFIX="$HOME/.npm-global"
export PATH="$NPM_CONFIG_PREFIX/bin:$PATH"

# spicetify  
export PATH=$PATH:/home/blackmage/.spicetify

# gpg pinentry-curses needs the calling TTY (guarded: silent in scripts)
[ -t 0 ] && export GPG_TTY=$(tty)

# cargo (guarded — missing until rustup/cargo installed via nix or rustup)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
