# Zsh keybindings only — readline `set ...` options live in ~/.inputrc
# (this file is sourced by zsh; sourcing readline syntax here was a no-op at best).

# incremental history search with arrow keys
bindkey "^[[A" history-beginning-search-backward
bindkey "^[[B" history-beginning-search-forward

# Left/Right move cursor
bindkey '\e[C' forward-char
bindkey '\e[D' backward-char

# Enable edit command line
autoload edit-command-line
zle -N edit-command-line
bindkey "^X^E" edit-command-line
