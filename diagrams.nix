{ lib, pkgs, inputs, ... }:
let
  # ── Diagram node definitions ──────────────────────────────────────
  inputNodesDef = {
    nixpkgs = "nixpkgs\n(github:NixOS/nixpkgs/nixos-unstable)";
    flake-parts = "flake-parts\n(github:hercules-ci/flake-parts)";
    import-tree = "import-tree\n(github:denful/import-tree)";
    home-manager = "home-manager\n(github:nix-community/home-manager)";
    nixos-hardware = "nixos-hardware\n(github:NixOS/nixos-hardware)";
    stylix = "stylix\n(github:nix-community/stylix)";
    llm-agents = "llm-agents\n(github:numtide/llm-agents.nix)";
    omp = "oh-my-pi\n(github:can1357/oh-my-pi)";
    luvus = "luvus\n(github:RizRiyz/luvus)";
    "nix-flatpak" = "nix-flatpak\n(github:gmodena/nix-flatpak@v0.7.0)";
    nixCats = "nixCats-nvim\n(github:BirdeeHub/nixCats-nvim)";
    spotifast = "spotifast\n(github:crmne/spotifast)";
    mocktail = "mocktail\n(github:komaruworld/mocktail)";
  };

  nixosModules = {
    base = "base.nix";
    boot = "boot.nix";
    audio = "audio.nix";
    battery = "battery.nix";
    desktop = "desktop.nix";
    firewall = "firewall.nix";
    firmware = "firmware.nix";
    flatpak = "flatpak.nix";
    fonts = "fonts.nix";
    gaming = "gaming.nix";
    graphics = "graphics.nix";
    input = "input.nix";
    networking = "networking.nix";
    niri = "niri.nix";
    "nix-ld" = "nix-ld.nix";
    plymouth = "plymouth.nix";
    power = "power.nix\n(power-profiles-daemon, no suspend/hibernate, logind lid=ignore)";
    printing = "printing.nix";
    rustdesk = "rustdesk.nix";
    steam = "steam.nix";
    stylix = "stylix.nix";
    thinkfan = "thinkfan.nix\n(manual fan: fan_control=1, watchdog=0, keepalive@1s)";
    user = "user.nix";
    backup = "backup.nix";
    firefox = "firefox.nix";
    nautilus = "nautilus.nix";
  };

  homeModules = {
    base = "base.nix\n(username, homedir, hm activation)";
    shell = "shell.nix\n(zsh + fzf-tab/autosuggestions/fast-syntax-highlighting/you-should-use, atuin, zoxide, eza)";
    niri = "niri.nix\n(KDL fragments + Stylix theming, niri-only guard)";
    foot = "foot.nix";
    kitty = "kitty.nix";
    btop = "btop.nix";
    "dev-keys" = "dev-keys.nix";
    gtk = "gtk.nix";
    hypridle = "hypridle.nix";
    hyprlock = "hyprlock.nix";
    luvus = "luvus.nix";
    mako = "mako.nix";
    mocktail = "mocktail.nix";
    omp = "omp.nix";
    packages = "packages.nix\n(home.packages list)";
    "sefirah-lock" = "sefirah-lock.nix";
    services = "services.nix\n(waybar user service)";
    starship = "starship.nix";
    tmux = "tmux.nix";
    tofi = "tofi.nix";
    "waybar-style" = "waybar-style.nix";
    yazi = "yazi.nix";
    zellij = "zellij.nix";
    stardew = "stardew.nix";
  };

  overlays = {
    "9router" = "9router.nix";
    sefirah = "sefirah.nix";
    "thinkfan-tui" = "thinkfan-tui.nix\n(builds thinkfan-tui from source)";
    "xwayland-satellite" = "xwayland-satellite.nix";
  };

  localPackages = {
    sefirah = "pkgs/sefirah/sefirah/\n(ordinal, cmd_cards, main, cmd_draw, hour_lines,\n lock_layout, key_digest, planetary_hour, battery,\n card_of_day, cmd_transmute)";
  };

  # ── Mermaid generation ────────────────────────────────────────────
  escape = s: lib.replaceStrings [ "\"" "\n" ] [ "\\\"" "\\n" ] s;

  node = id: label: "    ${id}[\"${escape label}\"]";

  subgraph = name: title: body: ''
    subgraph ${name}["${title}"]
        direction TB
    ${body}
    end
  '';

  edge = from: to: "    ${from} --> ${to}";

  # Build nodes
  inputNodes = lib.concatStringsSep "\n" (lib.mapAttrsToList (k: v: node "IN_${k}" v) inputNodesDef);

  coreNodes = lib.concatStringsSep "\n" [
    (node "CORE_FLAKE" "flake.nix\nflake-parts.mkFlake")
    (node "CORE_MKSYS" "lib/mkSystem.nix\nmkSystem { system, hostname, nixosModules, homeModules }")
    (node "CORE_IMPORT" "import-tree ./modules\n(auto-discovers all modules)")
  ];

  sefirahNodes = lib.concatStringsSep "\n" [
    (node "SEF_NM" "nixosModules\n(list of deferredModule)")
    (node "SEF_HM" "homeModules\n(list of deferredModule)")
  ];

  nixosNodes = lib.concatStringsSep "\n" (lib.mapAttrsToList (k: v: node "NM_${k}" v) nixosModules);
  homeNodes = lib.concatStringsSep "\n" (lib.mapAttrsToList (k: v: node "HM_${k}" v) homeModules);
  overlayNodes = lib.concatStringsSep "\n" (lib.mapAttrsToList (k: v: node "OV_${k}" v) overlays);
  pkgNodes = lib.concatStringsSep "\n" (lib.mapAttrsToList (k: v: node "PKG_${k}" v) localPackages);

  hwNode = (node "HW" "hardware-configuration.nix\n(generated by nixos-generate-config)");

  # Subgraphs
  inputGraph = subgraph "INPUTS" "🔮 Flake Inputs" inputNodes;
  coreGraph = subgraph "CORE" "⚡ Core Composition" coreNodes;
  sefirahGraph = subgraph "SEFIRAH" "config.sefirah" sefirahNodes;
  nixosGraph = subgraph "NIXOS" "modules/nixos/ (${builtins.toString (builtins.length (lib.attrNames nixosModules))} files)" nixosNodes;
  homeGraph = subgraph "HOME" "modules/home/ (${builtins.toString (builtins.length (lib.attrNames homeModules))} files)" homeNodes;
  overlayGraph = subgraph "OVERLAYS" "🎭 Overlays" overlayNodes;
  pkgGraph = subgraph "PKGS" "📦 Local Packages" pkgNodes;

  # Edges
  inputEdges = lib.concatStringsSep "\n" (lib.mapAttrsToList (k: _: edge "IN_${k}" "CORE_FLAKE") inputNodesDef);
  coreEdges = lib.concatStringsSep "\n" [
    (edge "CORE_FLAKE" "CORE_IMPORT")
    (edge "CORE_FLAKE" "CORE_MKSYS")
    (edge "CORE_IMPORT" "SEF_NM")
    (edge "CORE_IMPORT" "SEF_HM")
    (edge "CORE_MKSYS" "NM_niri")
    (edge "CORE_MKSYS" "HW")
  ];
  sefirahEdges = lib.concatStringsSep "\n" [
    (edge "SEF_NM" "NIXOS")
    (edge "SEF_HM" "HOME")
  ];
  hostEdges = lib.concatStringsSep "\n" [
    (edge "NM_niri" "IN_nixos-hardware")
    (edge "NM_niri" "HW")
  ];
  overlayEdges = lib.concatStringsSep "\n" [
    (edge "SEF_NM" "OVERLAYS")
    (edge "SEF_HM" "OVERLAYS")
  ];
  pkgEdges = lib.concatStringsSep "\n" [
    (edge "CORE_MKSYS" "PKGS")
    (edge "NM_niri" "PKGS")
  ];

  # Style definitions
  styles = ''
    classDef input fill:#1e1e2e,stroke:#cba6f7,color:#cdd6f4
    classDef core fill:#1e1e2e,stroke:#f9e2af,color:#cdd6f4
    classDef sefirah fill:#1e1e2e,stroke:#f5c2e7,color:#cdd6f4,stroke-width:2px
    classDef module fill:#1e1e2e,stroke:#a6e3a1,color:#cdd6f4
    classDef overlay fill:#1e1e2e,stroke:#fab387,color:#cdd6f4
    classDef pkg fill:#1e1e2e,stroke:#89b4fa,color:#cdd6f4
    classDef hw fill:#1e1e2e,stroke:#f38ba8,color:#cdd6f4

    class ${lib.concatStringsSep "," (lib.map (k: "IN_${k}") (lib.attrNames inputs))} input
    class CORE_FLAKE,CORE_MKSYS,CORE_IMPORT core
    class SEF_NM,SEF_HM sefirah
    class ${lib.concatStringsSep "," (lib.map (k: "NM_${k}") (lib.attrNames nixosModules))} module
    class ${lib.concatStringsSep "," (lib.map (k: "HM_${k}") (lib.attrNames homeModules))} module
    class ${lib.concatStringsSep "," (lib.map (k: "OV_${k}") (lib.attrNames overlays))} overlay
    class ${lib.concatStringsSep "," (lib.map (k: "PKG_${k}") (lib.attrNames localPackages))} pkg
    class HW hw
  '';

  # Full diagram
  diagram = lib.concatStringsSep "\n" [
    "flowchart TD"
    "    %% =========================================="
    "    %% sefirah — dendritic NixOS + Home Manager"
    "    %% Auto-generated from flake configuration"
    "    %% =========================================="
    ""
    inputGraph
    coreGraph
    sefirahGraph
    nixosGraph
    homeGraph
    overlayGraph
    pkgGraph
    ""
    hwNode
    ""
    inputEdges
    coreEdges
    sefirahEdges
    hostEdges
    overlayEdges
    pkgEdges
    ""
    styles
  ];

in
{
  diagrams-mermaid = diagram;

  diagrams-json = lib.toJSON {
    inputs = inputNodesDef;
    nixosModules = nixosModules;
    homeModules = homeModules;
    overlays = overlays;
    localPackages = localPackages;
  };

  diagrams-svg = pkgs.writeShellScriptBin "diagrams-svg" ''
    exec mermaid-cli -i /dev/stdin -o /dev/stdout <<< "${diagram}"
  '';

  update-readme = pkgs.writeShellScriptBin "update-readme" ''
    # This script is in modules/flake/update-readme.sh
    # Run it directly or via: nix run .#update-readme
    exec ${pkgs.bash}/bin/bash ${./modules/flake/update-readme.sh} "$@"
  '';
}